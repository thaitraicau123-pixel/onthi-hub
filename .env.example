# ==========================================
# FIREBASE CONFIGURATION FOR ONTHIHUB
# ==========================================
# Hướng dẫn:
# 1. Tạo project miễn phí tại https://console.firebase.google.com
# 2. Bật dịch vụ Authentication (Email/Password & Google)
# 3. Tạo Web App (</>) và copy các thông số bên dưới điền vào
# 4. Khi deploy Vercel, copy các biến này vào mục "Environment Variables" của Vercel Project

VITE_FIREBASE_API_KEY=AIzaSyYourActualApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ==========================================
# GOOGLE GEMINI AI API KEY (Miễn phí 100%)
# ==========================================
# Lấy key miễn phí trong 30s tại: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ==========================================
# SERVER-SIDE: NẠP XU TỰ ĐỘNG QUA SEPAY
# ==========================================
# KHÔNG commit giá trị thật. Khai báo tại Vercel → Settings → Environment Variables.
#
# 1) API Key webhook: SePay → Webhooks → sửa webhook → Authentication = "API Key"
#    rồi dán đúng key đó vào đây. Webhook gửi header: Authorization: Apikey <key>.
SEPAY_WEBHOOK_SECRET=
#
# 2) Service Account JSON (dán nguyên nội dung file .json, một dòng):
#    Firebase Console → Project settings → Service accounts → Generate new private key
#    Server dùng quyền này để cộng Xu vào Firestore (client không có quyền ghi ví).
FIREBASE_SERVICE_ACCOUNT=
#
# 3) Tuỳ chọn — mặc định đã đúng với dự án hiện tại.
FIREBASE_PROJECT_ID=promtmmo
FIRESTORE_DATABASE=default

# ==========================================
# AI PROMPT STUDIO — RESPAN GATEWAY (tuỳ chọn)
# ==========================================
# Nút "Cá nhân hoá prompt" gọi model qua respan-gateway (api/ai.py, in-process).
# Gateway tự đọc key nhà cung cấp bên dưới — chỉ cần MỘT key là đủ.
# Điền ở Vercel → Settings → Environment Variables, hoặc file .env.local (đã gitignore).
# TUYỆT ĐỐI không dán key thật vào file này hay bất kỳ file nào trong js/.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# Model chạy qua gateway. Đặt claude-* / gemini-* để gateway tự route sang nhà cung cấp khác.
GATEWAY_MODEL=gpt-4o-mini
# API key web công khai của Firebase (Firebase Console → Project settings → Your apps → apiKey).
# Server dùng key này để xác thực Firebase ID token trước khi gọi model (chống lạm dụng key).
FIREBASE_WEB_API_KEY=
#
# 4) BẮT BUỘC để dùng các nút quản trị (cộng Xu tay, duyệt, khoá, reset số dư):
#    danh sách email admin, cách nhau dấu phẩy. Không khai báo thì mọi action
#    quản trị trả 401/403 — đây là lớp chặn bot tự gọi API cộng Xu.
ADMIN_EMAILS=

# Hàng đợi khoản nạp chưa cộng được Xu (Redis REST, ví dụ Upstash free)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
